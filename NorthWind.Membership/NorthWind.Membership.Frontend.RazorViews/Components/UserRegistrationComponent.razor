<EditForm Model=ViewModel OnValidSubmit=ViewModel.Register>
    <ModelValidator Validator="ViewModel.Validator"
        @ref=ViewModel.ModelValidatorComponentReference />
    <ValidationSummary/>

    <div class="form-group">
        <label for="FirstName">
            @UserRegistrationMessages.FirstNameLabel
        </label>
        <InputText
            id="FirstName"
            class="form-control"
            maxlength="25"
            onkeydown="@("if(event.key.length===1&&!/[a-zA-ZáéíóúüñÁÉÍÓÚÜÑ ]/.test(event.key))event.preventDefault()")"
            placeholder=
                "@UserRegistrationMessages.FirstNameLabel"
            @bind-Value="ViewModel.FirstName"
            @bind-Value:after="SanitizeFirstName" />
        <ValidationMessage For="@(() => ViewModel.FirstName)" />
    </div>

    <div class="form-group">
        <label for="LastName">
            @UserRegistrationMessages.LastNameLabel
        </label>
        <InputText
            id="LastName"
            class="form-control"
            maxlength="25"
            onkeydown="@("if(event.key.length===1&&!/[a-zA-ZáéíóúüñÁÉÍÓÚÜÑ ]/.test(event.key))event.preventDefault()")"
            placeholder=
                "@UserRegistrationMessages.LastNameLabel"
            @bind-Value="ViewModel.LastName"
            @bind-Value:after="SanitizeLastName" />
        <ValidationMessage For="@(() => ViewModel.LastName)" />
    </div>

    <div class="form-group">
        <label for="Email">
            @CommonMessages.EmailLabel
        </label>
        <InputText
            id="Email"
            class="form-control"
            maxlength="50"
            onkeydown="@(@"if(event.key.length===1){if(!/[a-zA-Z0-9._@-]/.test(event.key))event.preventDefault();else{var p=event.target.value.split('@');if(event.key==='.'&&p.length===2&&/([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}$/.test(p[1]))event.preventDefault();}}")"
            placeholder="@CommonMessages.EmailLabel"
            @bind-Value="ViewModel.Email"
            @bind-Value:after="SanitizeEmail" />
        <ValidationMessage For="@(() => ViewModel.Email)" />
    </div>

    <div class="form-group">
        <label for="Password">
            @CommonMessages.PasswordLabel
        </label>
        <InputText
            id="Password"
            class="form-control"
            placeholder="@CommonMessages.PasswordLabel"
            type="password"
            @bind-Value=ViewModel.Password />
        <ValidationMessage For="@(() => ViewModel.Password)" />
    </div>

    <div class="form-group">
        <label for="PasswordConfirmation">
            @UserRegistrationMessages.PasswordConfirmationLabel
        </label>
        <InputText
            id="PasswordConfirmation"
            class="form-control"
            placeholder=
                "@UserRegistrationMessages.PasswordConfirmationLabel"
            type="password"
            @bind-Value=ViewModel.PasswordConfirmation />
        <ValidationMessage For="@(() => ViewModel.PasswordConfirmation)" />
    </div>

    <div class="form-actions">
        <button class="btn btn-primary btn-block">
            @UserRegistrationMessages.RegisterButtonText
        </button>
    </div>
</EditForm>

@if (!string.IsNullOrWhiteSpace(ViewModel.InformationMessage))
{
    <div class="form-alerts">
        <div class="alert alert-info" role="status">
            @ViewModel.InformationMessage
        </div>
    </div>
}
