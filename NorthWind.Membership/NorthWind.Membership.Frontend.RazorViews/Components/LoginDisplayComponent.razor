<AuthorizeView>
    <Authorized>
        <span class="user-chip">@GetUserName(context)</span>
        <a class="top-link" href="user/logout">
            @CommonMessages.CloseSessionText
        </a>
    </Authorized>
    <NotAuthorized>
        <a class="top-link" href="user/register">
            @CommonMessages.CreateAccountText
        </a>
        <a class="btn btn-primary btn-sm top-link-cta" href="user/login">
            @CommonMessages.LoginText
        </a>
    </NotAuthorized>
</AuthorizeView>

@code{
    string GetUserName(AuthenticationState context) =>
        context.User.Claims
        .Where(c => c.Type == "FullName")
        .Select(c => c.Value)
        .FirstOrDefault() ?? context.User.Identity?.Name ?? string.Empty;
}
