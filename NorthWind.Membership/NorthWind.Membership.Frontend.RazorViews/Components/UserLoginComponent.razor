<EditForm Model="ViewModel" OnValidSubmit="ViewModel.Login">
    <ModelValidator Validator="ViewModel.Validator"
        @ref=ViewModel.ModelValidatorComponentReference />
    <ValidationSummary />

    <div class="form-group">
        <label for="Email">
            @CommonMessages.EmailLabel
        </label>
        <InputText id="Email"
            class="form-control"
            maxlength="50"
            onkeydown="@(@"if(event.key.length===1){if(!/[a-zA-Z0-9._@-]/.test(event.key))event.preventDefault();else{var p=event.target.value.split('@');if(event.key==='.'&&p.length===2&&/([a-zA-Z0-9-]+\.)+[a-zA-Z]{2,}$/.test(p[1]))event.preventDefault();}}")"
            placeholder="@CommonMessages.EmailLabel"
            @bind-Value="ViewModel.Email"
            @bind-Value:after="SanitizeEmail" />
        <ValidationMessage For="@(() => ViewModel.Email)" />
    </div>

    <div class="form-group">
        <label for="Password">
            @CommonMessages.PasswordLabel
        </label>
        <InputText id="Password"
            class="form-control"
            placeholder="@CommonMessages.PasswordLabel"
            type="password"
            @bind-Value=ViewModel.Password />
        <ValidationMessage For="@(() => ViewModel.Password)" />
    </div>

    <div class="form-actions">
        <button class="btn btn-primary btn-block">
            @UserLoginMessages.LoginButtonText
        </button>
    </div>
</EditForm>
