<div class="nav-item">
    <NavLink class="nav-link" href=@HRef Match=@Match>
        @ChildContent
    </NavLink>
</div>

@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; } = default!;

    [Parameter]
    public string HRef { get; set; } = default!;

    [Parameter]
    public NavLinkMatch Match { get; set; }
}
