@page "/"
@using NorthWind.Sales.Frontend.Views.Resources

<PageTitle>@CommonMessages.HomeMenuItemTitle</PageTitle>

<div class="page-header">
    <h1>@CommonMessages.WelcomeHeading</h1>
    <p class="page-subtitle">@CommonMessages.WelcomeSubtitle</p>
</div>

<div class="home-grid">
    <a class="home-card" href="createorder">
        <span class="home-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                 fill="currentColor" class="bi bi-card-checklist" viewBox="0 0 16 16">
                <path d="M14.5 3a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5v9a.5.5 0 0 1 .5-.5zm-13-1A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2z" />
                <path d="M7 5.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 1 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0M7 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5m-1.496-.854a.5.5 0 0 1 0 .708l-1.5 1.5a.5.5 0 0 1-.708 0l-.5-.5a.5.5 0 0 1 .708-.708l.146.147 1.146-1.147a.5.5 0 0 1 .708 0" />
            </svg>
        </span>
        <span class="home-card-title">
            @CreateOrderMessages.CreateOrderMenuItemTitle
        </span>
        <p class="home-card-text">@CommonMessages.WelcomeNewOrderText</p>
        <span class="home-card-cta">@CommonMessages.ExploreOptionsText &rarr;</span>
    </a>

    <a class="home-card" href="invoices">
        <span class="home-card-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
                 fill="currentColor" class="bi bi-receipt" viewBox="0 0 16 16">
                <path d="M3 2.5A1.5 1.5 0 0 1 4.5 1h7A1.5 1.5 0 0 1 13 2.5v11a.5.5 0 0 1-.5.5h-7a.5.5 0 0 1-.5-.5v-12zM4.5 2a.5.5 0 0 0-.5.5v11h7v-11a.5.5 0 0 0-.5-.5h-7zM6 4.5h4v1H6v-1zm0 2h4v1H6v-1zm0 2h3v1H6v-1z" />
            </svg>
        </span>
        <span class="home-card-title">
            @InvoiceMessages.InvoicesMenuItemTitle
        </span>
        <p class="home-card-text">@CommonMessages.WelcomeInvoicesText</p>
        <span class="home-card-cta">@CommonMessages.ExploreOptionsText &rarr;</span>
    </a>
</div>

<AuthorizeView>
    <NotAuthorized>
        <div class="alert alert-info home-hint" role="note">
            @CommonMessages.LoginRequiredHint
        </div>
    </NotAuthorized>
</AuthorizeView>
